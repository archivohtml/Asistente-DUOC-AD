# Copia este archivo a .env y completa tu propia clave. NUNCA subas .env al repositorio.
OPENROUTER_API_KEY=tu_clave_aqui
OPENROUTER_MODEL=openai/gpt-5.4
# Opcional: modelo más barato/rápido solo para el planificador
# PLANNER_MODEL=openai/gpt-5.4-mini
# Opcional: fija "hoy" para demos reproducibles (yyyy-mm-dd)
# FECHA_SIMULADA=2026-10-07
# Opcional
# USUARIO_ID=usuario-local
# MEMORIA_PATH=data/memoria/perfiles.json
# SALIDAS_PATH=salidas
# Recuperación semántica (embeddings vía OpenRouter)
# EMBEDDING_MODEL=openai/text-embedding-3-small
# SEMANTIC_MIN_SCORE=0.30      # umbral de similitud coseno; calíbralo con `npm run calibrar`
# SEMANTIC_MARGIN=0.12         # solo conserva resultados cercanos al mejor
# SEMANTIC_SEARCH=off          # desactiva embeddings (solo palabras clave)
# EMBEDDINGS_CACHE=data/embeddings/indice.json
